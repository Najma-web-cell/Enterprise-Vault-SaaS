generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String   @unique
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]

  @@map("companies")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(EMPLOYEE)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("users")
}
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  userName  String?
  userEmail String?
  action    String   // e.g., "MEMBER_CREATED", "MEMBER_DELETED", "TENANT_LOGIN"
  details   String?  // Action ki details ya metadata (JSON string ya description)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}